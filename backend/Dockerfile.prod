FROM php:8.2.35-fpm

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl libpng-dev libonig-dev libxml2-dev libzip-dev libpq-dev unzip \
    && docker-php-ext-install pdo_pgsql mbstring exif pcntl bcmath gd zip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www
COPY . .
RUN mkdir -p bootstrap/cache storage/framework/views \
    && composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader \
    && chmod +x docker/production-entrypoint.sh

EXPOSE 9000
ENTRYPOINT ["/bin/sh", "/var/www/docker/production-entrypoint.sh"]
CMD ["php-fpm"]

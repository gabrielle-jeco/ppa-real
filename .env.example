APP_NAME=YoDaily
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8082

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SANCTUM_EXPIRATION=1440
PHP_MEMORY_LIMIT=1024M

MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

YOJADWAL_ENABLED=true
YOJADWAL_BASE_URL=
YOJADWAL_LOGIN_PATH=
YOJADWAL_PRESENCE_PATH=
YOJADWAL_APP_CLIENT=Android-Mobile-App
YOJADWAL_TOKEN=
YOJADWAL_COOKIE=
YOJADWAL_TIMEOUT=10
YOJADWAL_NIK_FIELD=username
YOJADWAL_PASSWORD_FIELD=
YOJADWAL_SUCCESS_FIELD=success
YOJADWAL_ALLOW_LOCAL_SUPERADMIN_FALLBACK=false
YODAILY_USER_MONITORING_PASSWORD=

BEYOND_CASHIER_ENABLED=false
BEYOND_CASHIER_BASE_URL=
BEYOND_CASHIERS_PATH=
BEYOND_IBOP_PATH=
BEYOND_PUSH_SELLING_PATH=
BEYOND_CASHIER_TOKEN=
BEYOND_CASHIER_TIMEOUT=20

WEB_PUSH_ENABLED=true
WEB_PUSH_SUBJECT=https://yodaily.yogya.co.id
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

VITE_WEB_PUSH_PUBLIC_KEY=
VITE_ENABLE_BULK_ASSIGNMENT=true
VITE_ENABLE_TASK_WEIGHT=false

BACKEND_PORT=8082
FRONTEND_PORT=8081
DB_FORWARD_PORT=5758
TZ=Asia/Jakarta

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
